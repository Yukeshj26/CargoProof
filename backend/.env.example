# Core runtime
APP_NAME=CargoProof AI
FRONTEND_ORIGINS=http://localhost:5173
DEMO_MODE=true
STORAGE_MODE=auto
SQLITE_PATH=data/cargoproof.db

# Firebase Authentication (backend token verification)
FIREBASE_PROJECT_ID=cargoproof-ccb53
# Set GOOGLE_APPLICATION_CREDENTIALS to the path of your Firebase service-account JSON file

# Supabase (optional: PostgreSQL storage only; no longer used for authentication)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Provider integrations: only enter documented URLs/endpoints from your provider contract/docs
LIVE_PROVIDER_MODE=false
PROVIDER_TIMEOUT_SECONDS=12
PROVIDER_MAX_RETRIES=1
STRALE_API_BASE=
STRALE_ENDPOINT=
STRALE_API_KEY=
AISFLEET_API_BASE=
AISFLEET_ENDPOINT=
AISFLEET_API_KEY=
SYNTHORA_API_BASE=
SYNTHORA_ENDPOINT=
SYNTHORA_API_KEY=

# Quote and procurement budgets (USD)
DEFAULT_MARKUP_PERCENT=30
PROCESSING_ALLOWANCE_USD=0.006
TAX_PERCENT=0
QUOTE_TTL_MINUTES=15
MAX_AGENT_BUDGET_USD=25
MAX_AGENT_REQUESTS=10
MAX_DAILY_AGENT_SPEND_USD=100

# Customer payment verification: Base Sepolia USDC (not x402 provider payment)
LIVE_PAYMENTS_ENABLED=false
BASE_CHAIN_ID=84532
BASE_RPC_URL=
BASE_USDC_ADDRESS=
CARGOPROOF_TREASURY_ADDRESS=
MAX_PAYMENT_USD=25

# x402 provider payments: GoPlausible Algorand AVM facilitator
X402_ENABLED=false
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz
X402_NETWORK=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=
X402_ASSET_ID=10458941
TEST_PROVIDER_ENABLED=false
TEST_PROVIDER_PAY_TO=
TEST_PROVIDER_BASE_URL=http://127.0.0.1:8000
TEST_PROVIDER_PRICE_USD=0.01
X402_AVM_MNEMONIC=

# Algorand TestNet escrow (separate from x402 purchases)
